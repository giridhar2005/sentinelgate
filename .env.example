# SentinelGate Environment Configuration Example
# Copy to .env or export into your environment

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY_BACKUP=sk-proj-yyyyyyyyyyyyyyyyyyyyyyyy

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_BACKUP=gsk_yyyyyyyyyyyyyyyyyyyyyyyy

GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_BACKUP=AIzaSyyyyyyyyyyyyyyyyyyyyyyy

# Ollama local base url (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# SQLite Database path (default: sentinelgate.db)
SENTINELGATE_DB=sentinelgate.db
