{
  "name": "SentinelGate",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "SentinelGate HUD",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -e . && python -m sentinelgate --host 0.0.0.0 --port 8000 > /tmp/sentinelgate.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
